<header class="main-header">
    <!-- Logo -->
    <a href="/" class="logo">
        <!-- Mini logo -->
        <span class="logo-mini"><b>N</b>FH</span>
        <!-- Logo full -->
        <span class="logo-lg"><b>Naratel - </b>FTTH</span>
    </a>

    <!-- Navbar -->
    <nav class="navbar navbar-static-top">
        <!-- Sidebar toggle button -->
        <a href="#" class="sidebar-toggle" role="button">
            <span class="sr-only">Toggle navigation</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </a>

        <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">
                <!-- Notifications -->
                <li class="dropdown notifications-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <i class="fa fa-bell-o" style="color:#777;"></i>
                        <span class="label" style="background-color: #6c5ce7;">10</span>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="header">You have 10 notifications</li>
                        <li>
                            <ul class="menu">
                                <li><a href="#"><i class="fa fa-users text-aqua"></i> 5 new members joined today</a></li>
                                <li><a href="#"><i class="fa fa-warning text-yellow"></i> Warning alert</a></li>
                                <li><a href="#"><i class="fa fa-shopping-cart text-green"></i> 25 sales made</a></li>
                            </ul>
                        </li>
                        <li class="footer"><a href="#">View all</a></li>
                    </ul>
                </li>

                <!-- User Account -->
                <li class="dropdown user user-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <img src="/backend/profile_user/boy.jpeg" class="user-image" alt="User Image">
                        <span class="hidden-xs"><%= user.nama %></span>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="user-header">
                            <img src="/backend/profile_user/boy.jpeg" class="img-circle" alt="User Image">
                            <p>
                                <%= user.nama %> - <%= user.divisi %>
                                <small>Member since <%= user.created_at %></small>
                            </p>
                        </li>
                        <li class="user-footer">
                            <div class="pull-left">
                                <a href="/profile" class="btn btn-default btn-flat">Profile</a>
                            </div>
                            <div class="pull-right">
                                <a href="/logout" class="btn btn-default btn-flat">Sign out</a>
                            </div>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>
