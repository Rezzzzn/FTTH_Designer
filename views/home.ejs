    <script>
function clearMap() {
    markers.forEach(marker => marker.setMap(null));
    polylines.forEach(polyline => polyline.setMap(null));
    markers = [];
    polylines = [];
}
document.getElementById("kmlFile").addEventListener("change", function (event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function (e) {
        const kmlText = e.target.result;
        importKML(kmlText); // Panggil fungsi tadi
    };
    reader.readAsText(file);
});


function parseKML(kmlString) {
    const parser = new DOMParser();
    const xmlDoc = parser.parseFromString(kmlString, "text/xml");

    const placemarks = xmlDoc.getElementsByTagName("Placemark");
    const polylines = [];
    const pointMarkers = [];

    for (let placemark of placemarks) {
        const lineString = placemark.getElementsByTagName("LineString")[0];
        const point = placemark.getElementsByTagName("Point")[0];

        if (lineString) {
            const coordsText = lineString.getElementsByTagName("coordinates")[0].textContent.trim();
            const coordPairs = coordsText.split(/\s+/).map(coord => {
                const [lng, lat] = coord.split(",").map(Number);
                return [lat, lng];
            });

            const path = coordPairs.map(([lat, lng]) => new google.maps.LatLng(lat, lng));
            const kabel = google.maps.geometry.spherical.computeLength(path);

            polylines.push({
                polyline: coordPairs,
                markers: [],
                tiang: 0,
                kabel: Math.round(kabel)
            });
        } else if (point) {
            const coordsText = point.getElementsByTagName("coordinates")[0].textContent.trim();
            const [lng, lat] = coordsText.split(",").map(Number);
            pointMarkers.push([lat, lng]);
        }
    }

    // Pasangkan markers ke polyline terdekat
    for (const [lat, lng] of pointMarkers) {
        const markerLatLng = new google.maps.LatLng(lat, lng);
        let closestIndex = -1;
        let minDistance = Infinity;

        for (let i = 0; i < polylines.length; i++) {
            const path = polylines[i].polyline.map(([lt, ln]) => new google.maps.LatLng(lt, ln));
            for (let j = 0; j < path.length - 1; j++) {
                const segDist = google.maps.geometry.spherical.computeDistanceBetween(markerLatLng, path[j]);
                if (segDist < minDistance) {
                    minDistance = segDist;
                    closestIndex = i;
                }
            }
        }

        if (closestIndex !== -1) {
            polylines[closestIndex].markers.push([lat, lng]);
        }
    }

    polylines.forEach(p => {
        p.tiang = p.markers.length;
    });

    return polylines;
}

function calculateLength(path) {
    let length = 0;
    for (let i = 0; i < path.length - 1; i++) {
        length += google.maps.geometry.spherical.computeDistanceBetween(path[i], path[i + 1]);
    }
    return length;
}

function simplifyPath(path, minDistance = 1) {
    if (path.length <= 1) return path;
    let simplified = [path[0]];

    for (let i = 1; i < path.length; i++) {
        const last = simplified[simplified.length - 1];
        const current = path[i];
        const distance = google.maps.geometry.spherical.computeDistanceBetween(last, current);

        if (distance >= minDistance) {
            simplified.push(current);
        }
    }
    return simplified;
}

document.addEventListener("DOMContentLoaded", () => {
    const saveButton = document.getElementById("saveImportlock");
    const saveProjectBtn = document.getElementById("saveProject");
    const projectNameInput = document.getElementById("projectName");

    if (saveButton) {
        saveButton.addEventListener("click", () => {
            if (!projectSegments || projectSegments.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Data belum tersedia',
                    text: 'Silakan import file KML terlebih dahulu.'
                });
                return;
            }

            // Tampilkan modal
            $('#projectModal').modal('show');
        });
    }

    if (saveProjectBtn) {
        saveProjectBtn.addEventListener("click", () => {
            const projectName = projectNameInput.value.trim();

            if (!projectName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Nama Project Kosong',
                    text: 'Silakan isi nama project terlebih dahulu.'
                });
                return;
            }

            // Tutup modal
            $('#projectModal').modal('hide');

            // Format dan siapkan data project
            const fixedSegments = projectSegments.map(s => ({
                name: s.name || '',
                tiang: s.tiang || 0,
                kabel: s.kabel || 0,
                markers: s.markers || [],
                polyline: s.polyline || []
            }));

            const totalTiang = fixedSegments.reduce((sum, s) => sum + (s.tiang || 0), 0);
            const totalKabel = fixedSegments.reduce((sum, s) => sum + (s.kabel || 0), 0);

            const data = {
                projectName,
                totalTiang,
                totalKabel,
                segments: fixedSegments
            };

            // Simpan ke localStorage
            localStorage.setItem("boqData", JSON.stringify(data));
            localStorage.setItem("latestProjectName", projectName);

            // Kirim ke server
            fetch("/api/save-project", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(result => {
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: 'Project berhasil disimpan!',
                    confirmButtonText: 'OK'
                }).then(() => {
                    window.location.href = "/boq";
                });
            })
            .catch(error => {
                console.error("Gagal menyimpan:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Terjadi kesalahan saat menyimpan data.'
                });
            });
        });
    }
});
        </script>
        
    
