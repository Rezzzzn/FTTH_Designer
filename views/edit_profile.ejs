<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile - Project Map</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="assets/css/styles.css">
    <link rel="stylesheet" href="assets/css/sidebar.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="/get-google-maps-api"></script>
    <style>

        html, body {
        overflow: hidden !important;
        }
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f7fc;
        }
        
        .profile-container {
            margin-top: 20px;
            margin-bottom: 30px;
        }
        
        .profile-header {
            background: linear-gradient(135deg, #343a40, #6c757d);
            color: white;
            padding: 30px;
            border-radius: 10px 10px 0 0;
            margin-bottom: 0;
            position: relative;
            overflow: hidden;
        }
        
        .profile-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #1a2234 0%, #242e48 100%) center/cover !important;
            
            z-index: 0;
        }
        
        .profile-header-content {
            position: relative;
            z-index: 1;
        }
        
        .profile-image-container {
            position: relative;
            width: 150px;
            height: 150px;
            margin: 0 auto;
        }
        
        .profile-image {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid #fff;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
        }
        
        .profile-image:hover {
            transform: scale(1.05);
        }
        
        .profile-image-edit {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background-color: #343a40;
            color: white;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 3px 8px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
        }
        
        .profile-image-edit:hover {
            background-color: #181818;
            transform: scale(1.1);
        }
        
        .profile-card {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            padding: 25px;
            transition: all 0.3s ease;
        }
        
        .profile-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }
        
        .profile-info-card {
            border-radius: 10px;
            margin-bottom: 20px;
        }
        
        .form-group label {
            font-weight: 600;
            font-size: 14px;
            color: #495057;
            margin-bottom: 8px;
        }
        
        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        
        .form-control:focus {
            border-color: #343a40;
            box-shadow: 0 0 0 0.2rem rgba(52, 58, 64, 0.15);
        }
        
        .btn {
            border-radius: 8px;
            padding: 10px 25px;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
    align-items: center;
    justify-content: center;
        }
        
        .btn-save {
            background-color: #28a745;
            color: white;
            border: none;
        }
        
        .btn-save:hover {
            background-color: #218838;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(40, 167, 69, 0.3);
        }
        
        .btn-cancel {
            background-color: #6c757d;
            color: white;
            border: none;
        }
        
        .btn-cancel:hover {
            background-color: #5a6268;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(108, 117, 125, 0.3);
        }
        
        .info-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        .info-item:hover {
            background-color: #f8f9fa;
        }
        
        .info-icon {
            width: 40px;
            height: 40px;
            background-color: #e9ecef;
            color: #343a40;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            transition: all 0.3s ease;
        }
        
        .info-item:hover .info-icon {
            background-color: #343a40;
            color: white;
        }
        
        .info-content h6 {
            margin-bottom: 3px;
            font-weight: 600;
        }
        
        .info-content p {
            margin-bottom: 0;
            color: #6c757d;
        }
        
        .tab-header {
            display: flex;
            border-bottom: 2px solid #e9ecef;
            margin-bottom: 20px;
        }
        
        .tab-item {
            padding: 15px 20px;
            font-weight: 600;
            color: #6c757d;
            cursor: pointer;
            position: relative;
            transition: all 0.3s ease;
        }
        
        .tab-item.active {
            color: #343a40;
        }
        
        .tab-item.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: #343a40;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        .social-input {
            position: relative;
        }
        
        .social-input i {
            position: absolute;
            left: 15px;
            top: 14px;
            color: #6c757d;
        }
        
        .social-input .form-control {
            padding-left: 45px;
        }
        
        .save-indicator {
            display: none;
            align-items: center;
            justify-content: center;
            color: #000000;
            margin-right: 15px;
        }
        
        .save-indicator i {
            margin-right: 5px;
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .profile-container {
                width: 95%;
            }
            
            .profile-header {
                padding: 20px;
            }
            
            .profile-image-container {
                width: 120px;
                height: 120px;
            }
        }
        
        @media (max-width: 480px) {
            .profile-container {
                width: 100%;
            }
            
            .tab-item {
                padding: 10px 15px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    <header class="navbar navbar-dark bg-dark p-3">
        <div class="ml-auto">
             <a class="text-light mx-2" title="Menuju Halaman Home" href="/home"><i class="fas fa-home"></i></a>
            <a class="text-light mx-2" title="Menuju Halaman User" href="/edit_profile"><i class="fas fa-user"></i></a>
        </div>
    </header>

    <aside class="main-sidebar">
        <a class="navbar-brand" href="/home" style="margin-left:4rem; color: white; margin-top: 1rem;">Project Map</a>
        <div class="sidebar-divider"></div>
        
        <div class="user-panel">
            <div class="pull-left image">
                <img src="/uploads/<%= profilePicture %>" alt="User Profile Picture">
                <span class="status-indicator"></span>
            </div>
            <div class="pull-left info">
                <h5 class="hidden-xs"><%= name %></h5>
                <p class="user-role">Network Administrator</p>
            </div>
        </div>
    
        <div class="sidebar-divider"></div>
    
        <div class="sidebar-heading">Main Navigation</div>
    
        <ul class="sidebar-menu">
            <li class="nav-item" style="margin-top: 10px;">
                <a href="/home" class="nav-link d-flex align-items-center">
                    <i class="fas fa-tachometer-alt" style="margin-right: 10px;"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item active" style="margin-top: 10px;">
                <a href="#" class="nav-link d-flex align-items-center">
                    <i class="fas fa-user-edit" style="margin-right: 10px;"></i>
                    <span>Edit Profile</span>
                </a>
            </li>
        </ul>
    </aside>
    
    <section class="content-header" style="margin-top: 50px;">
        <!-- <div class="header-container">
            <div class="header-title">
                <div class="header-text">
                    <span class="header-main">Edit Profile</span>
                    <span class="header-sub">Pengaturan Informasi Akun</span>
                </div>
            </div>
        </div> -->

        <div class="row">
            <div class="col-lg-12 col-xs-12">
                <div class="profile-container">
                    <!-- Profile Header -->
                    <div class="profile-header">
                        <div class="profile-header-content text-center">
                            <div class="profile-image-container">
                                <img src="/uploads/<%= profilePicture %>" alt="User Profile Picture" class="profile-image">
                                
                                
                            </div>
                            <h4 class="mt-3 mb-1"><%= name %></h4>
                            <p class="text-white-50">Network Administrator</p>
                        </div>
                    </div>
                    
                    <!-- Profile Content -->
                    <div class="profile-card">
                        <div class="tab-header">
                            <div class="tab-item active" data-tab="personal">Informasi Pribadi</div>
                            <div class="tab-item" data-tab="password">Keamanan</div>
                            
                        </div>
                        
                        <form id="profileEditForm" action="/profile/edit" method="POST">
                            <!-- Personal Information Tab -->
                            <div id="personal" class="tab-content active">
                                <div class="row">
                                 
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="username">Name</label>
                                            <input type="text" class="form-control" id="email" name="email" value="<%= name %>">

                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="email">Username</label>
                                            <input type="text" class="form-control" id="name" name="name" value="<%= email %>">
                                        </div>
                                    </div>
                                  
                                </div>
                                
                          
                                </div>
                                
                         
                                
                            
                            
                            <!-- Password Tab -->
                            <div id="password" class="tab-content">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label for="currentPassword">Password Saat Ini</label>
                                            <input type="password" class="form-control" id="currentPassword" name="currentPassword" placeholder="Masukkan password saat ini">
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="newPassword">Password Baru</label>
                                            <input type="password" class="form-control" id="newPassword" name="newPassword" placeholder="Masukkan password baru">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="confirmPassword">Konfirmasi Password</label>
                                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Konfirmasi password baru">
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="alert alert-info" role="alert">
                                    <i class="fas fa-info-circle mr-2"></i>
                                    Password harus memiliki minimal 8 karakter dengan kombinasi huruf kecil, huruf besar, angka, dan simbol.
                                </div>
                            </div>
                            
                            <!-- Social Media Tab -->
                            
                            
                            <div class="text-right mt-4">
                                <div class="d-flex justify-content-end align-items-center">
                                    <div class="save-indicator" id="saveIndicator">
                                        <i class="fas fa-check-circle"></i>
                                        <span>Perubahan disimpan!</span>
                                    </div>
                                    <a href="/home" class="btn btn-cancel mr-2">Batal</a>
                                    <button type="submit" class="btn btn-save">Simpan Perubahan</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script src="/assets/js/edit.js"></script>
    <!-- Script to handle profile interactions -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
    // Profile image handling
    const profileImageEdit = document.querySelector('.profile-image-edit');
    const profileImageInput = document.getElementById('profileImageInput');
    const profileImage = document.querySelector('.profile-image');
    const profileForm = document.getElementById('profileEditForm');
    const saveIndicator = document.getElementById('saveIndicator');
    
    // Tab switching functionality
    const tabItems = document.querySelectorAll('.tab-item');
    const tabContents = document.querySelectorAll('.tab-content');
    
    tabItems.forEach(item => {
        item.addEventListener('click', function() {
            const tabId = this.getAttribute('data-tab');
            
            // Remove active class from all tabs
            tabItems.forEach(tab => tab.classList.remove('active'));
            tabContents.forEach(content => content.classList.remove('active'));
            
            // Add active class to clicked tab
            this.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        });
    });

    $('#profileEditForm').on('submit', function(e) {
        e.preventDefault();

        // Ambil data dari form
        if (!validateForm()) return;

        $.ajax({
            url: '/profile/edit',
            method: 'POST',
            data: $(this).serialize(),
            success: function(response) {
                $('#notifArea').html(`<div class="alert alert-success">${response.message}</div>`);
                showSaveIndicator('Perubahan disimpan!');

                // Refresh halaman setelah perubahan berhasil
                location.reload();
            },
            error: function(xhr) {
                const err = xhr.responseJSON?.message || 'Terjadi kesalahan.';
                $('#notifArea').html(`<div class="alert alert-danger">${err}</div>`);
            }
        });
    });



        // Handle clicking the edit profile image button
        profileImageEdit.addEventListener('click', function() {
            profileImageInput.click();
        });
        
        // Handle file selection for profile picture
        profileImageInput.addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                
                reader.onload = function(event) {
                    profileImage.src = event.target.result;
                    
                    // Show success indicator
                    showSaveIndicator('Foto profil diperbarui!');
                }
                
                reader.readAsDataURL(e.target.files[0]);
            }
        });
        
        // Form validation function
        function validateForm() {
            // Get values
            const email = document.getElementById('email').value;
            const currentPassword = document.getElementById('currentPassword')?.value;
            const newPassword = document.getElementById('newPassword')?.value;
            const confirmPassword = document.getElementById('confirmPassword')?.value;
            
            // Validate email format
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (email && !emailRegex.test(email)) {
                alert('Format email tidak valid!');
                return false;
            }
            
            // Validate passwords match if entered
            if (newPassword && newPassword !== confirmPassword) {
                alert('Password baru tidak cocok dengan konfirmasi password!');
                return false;
            }
            
            // Password strength validation if entered
            if (newPassword && newPassword.length < 8) {
                alert('Password baru harus memiliki minimal 8 karakter!');
                return false;
            }
            
            return true;
        }
       
        // Function to show save indicator
        function showSaveIndicator(message) {
            if (message) {
                saveIndicator.querySelector('span').textContent = message;
            }
            
            saveIndicator.style.display = 'flex';
            
            setTimeout(() => {
                saveIndicator.style.display = 'none';
            }, 3000);
        }
        
        // Handle form submission
        
        // Make form inputs show save indicator when changed
        const formInputs = document.querySelectorAll('.form-control');
        formInputs.forEach(input => {
            input.addEventListener('change', function() {
                // Auto-save functionality would go here in a real app
                // For demo purposes, we're just showing the indicator
                showSaveIndicator('Perubahan otomatis disimpan!');
            });
        });
    });
    </script>

    <!-- Bootstrap and jQuery script imports -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>