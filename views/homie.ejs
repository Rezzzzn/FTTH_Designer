<script>
 const projectId = <%= projectId %>;

// Panggil otomatis saat halaman dibuka
window.onload = () => {
    viewProjectMap(projectId);
};

function viewProjectMap(projectId) {
    fetch(`/project/${projectId}/map-data`)
        .then(res => res.json())
        .then(data => {
            console.log("Data dari server:", data);

            const mapMarkers = [];
            const segments = {};  // Variabel untuk menyimpan data titik berdasarkan segment_id

            if (data.jalur && Array.isArray(data.jalur) && data.jalur.length > 0) {
                // Pisahkan titik berdasarkan segment_id dan type
                data.jalur.forEach(point => {
                    const sid = point.segment_id;
                    if (!segments[sid]) segments[sid] = { markers: [], polyline: [] };

                    // Tambahkan titik untuk polyline
                    if (point.type === 'polyline') {
                        segments[sid].polyline.push({
                            sequence: point.sequence,
                            lat: parseFloat(point.lat),
                            lng: parseFloat(point.lng),
                            point_id: point.point_id
                        });
                    }

                    // Tambahkan marker
                    if (point.type === 'marker') {
                        segments[sid].markers.push({
                            lat: parseFloat(point.lat),
                            lng: parseFloat(point.lng),
                            point_id: point.point_id
                        });
                    }
                });

                // Gambar polyline untuk setiap segment
                Object.keys(segments).forEach(segmentId => {
                    const { polyline } = segments[segmentId];

                    // Pastikan ada lebih dari 1 titik untuk membuat polyline
                    if (polyline.length < 2) return;

                    // Urutkan titik-titik berdasarkan urutan sequence
                    polyline.sort((a, b) => a.sequence - b.sequence);

                    const polylinePath = polyline.map(point => ({
                        lat: point.lat,
                        lng: point.lng
                    }));

                    // Cek apakah titik pertama dan terakhir sangat mirip (prevent loop)
                    const first = polylinePath[0];
                    const last = polylinePath[polylinePath.length - 1];
                    const isSamePoint = 
                        first.lat === last.lat && 
                        first.lng === last.lng;

                    // Jika titik pertama dan terakhir sangat mirip, potong titik terakhir
                    const finalPath = isSamePoint ? polylinePath.slice(0, -1) : polylinePath;

                    console.log(`Drawing Polyline for Segment ${segmentId}:`, finalPath);

                    // Buat polyline dan tambahkan ke map
                    const polylineObj = new google.maps.Polyline({
                        path: finalPath,
                        geodesic: true,
                        strokeColor: "#FFA500",
                        strokeOpacity: 1.0,
                        strokeWeight: 2
                    });
                    polylineObj.setMap(map);  // Tambahkan polyline ke peta
                });

                // Gambar marker untuk setiap segment
                Object.keys(segments).forEach(segmentId => {
                    const { markers } = segments[segmentId];
                    markers.forEach(marker => {
                        new google.maps.Marker({
                            position: {
                                lat: marker.lat,
                                lng: marker.lng
                            },
                            map: map,
                            title: `Segment ${segmentId}, Point ID ${marker.point_id}`
                        });
                    });
                });
            } else {
                console.warn("Data jalur kosong atau tidak ditemukan.");
            }
        })
        .catch(error => {
            console.error("Terjadi error saat mengambil data:", error);
        });
}


  </script>
