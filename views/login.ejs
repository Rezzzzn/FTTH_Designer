<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
  <title>Naratel FTTH - Login</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap">
  <link rel="stylesheet" href="assets/vendor/bootstrap/dist/css/bootstrap.min.css">
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Outfit', sans-serif;
    }

    body {
      min-height: 100vh;
      background: #e9ecef;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .login-container {
      width: 100%;
      max-width: 400px;
    }

    .login-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .login-header h1 {
      font-size: 32px;
      font-weight: 600;
      margin: 0;
      background: linear-gradient(to right, #6c5ce7, #a594f9);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }

    .login-card {
      background: #f8f9fa;
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    }

    .welcome-text {
      color: #6c757d;
      font-size: 15px;
      margin-bottom: 32px;
      text-align: center;
    }

    .form-group {
      margin-bottom: 24px;
      position: relative;
    }

    .form-control {
      width: 100%;
      height: 56px;
      background: #e9ecef;
      border: 2px solid #dee2e6;
      border-radius: 16px;
      padding: 0 20px;
      color: #495057;
      font-size: 15px;
      transition: all 0.3s;
    }

    .form-control:focus {
      background: #f1f3f5;
      border-color: #6c5ce7;
      box-shadow: 0 0 0 4px rgba(108, 92, 231, 0.1);
      outline: none;
    }

    .form-control::placeholder {
      color: #adb5bd;
    }

    .remember-forgot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
    }

    .remember-me {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .checkbox-wrapper {
      position: relative;
      display: inline-block;
    }

    .custom-checkbox {
      appearance: none;
      -webkit-appearance: none;
      width: 20px;
      height: 20px;
      background: #e9ecef;
      border: 2px solid #dee2e6;
      border-radius: 6px;
      cursor: pointer;
      position: relative;
      transition: all 0.2s;
    }

    .custom-checkbox:checked {
      background: #6c5ce7;
      border-color: #6c5ce7;
    }

    .custom-checkbox:checked::after {
      content: '✓';
      position: absolute;
      color: #f8f9fa;
      font-size: 14px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .checkbox-label {
      color: #6c757d;
      font-size: 14px;
      cursor: pointer;
    }

    .forgot-link {
      color: #6c5ce7;
      font-size: 14px;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }

    .forgot-link:hover {
      color: #5f4dd0;
    }

    .btn-login {
      width: 100%;
      height: 56px;
      background: linear-gradient(to right, #6c5ce7, #a594f9);
      border: none;
      border-radius: 16px;
      color: #f8f9fa;
      font-size: 16px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }

    .btn-login::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(to right, transparent, rgba(255,255,255,0.2), transparent);
      transition: all 0.5s;
    }

    .btn-login:hover::before {
      left: 100%;
    }

    .btn-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px -5px rgba(108, 92, 231, 0.4);
    }

    @keyframes fadeScale {
      from { 
        opacity: 0;
        transform: scale(0.98);
      }
      to { 
        opacity: 1;
        transform: scale(1);
      }
    }

    .login-container {
      animation: fadeScale 0.4s ease-out;
    }
  </style>
</head>
<body>
  <div class="login-container">
 
    
    <div class="login-card"> 
        <div class="login-header">
      <h1>Naratel FTTH</h1>
    </div>
      <p class="welcome-text">Sign in to your account</p>
      
      <form action="/login" method="post">
        <div class="form-group">
          <input 
            type="name" 
            class="form-control" 
            name="username" 
            placeholder="Nama User"
            required
          >
        </div>
        
        <div class="form-group">
          <input 
            type="password" 
            class="form-control" 
            name="password" 
            placeholder="Password"
            required
          >
        </div>
        
        <button type="submit" class="btn-login">
          Sign In
        </button>
      </form>
    </div>
  </div>

  <script src="assets/vendor/jquery/dist/jquery.min.js"></script>
  <script src="assets/vendor/bootstrap/dist/js/bootstrap.min.js"></script>
</body>
</html>